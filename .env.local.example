# ── Matoshree Fruits environment variables ─────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — NEVER commit real secrets.

# MongoDB Atlas connection string (cluster → connect → drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/matoshreefruits?retryWrites=true&w=majority

# Admin account used by scripts/create-admin.js
ADMIN_EMAIL=admin@matoshreefruits.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Niranjan

# OPTIONAL — hardens the one-time /admin/setup page. When set, the setup form
# must also present this key before the first admin is created. Leave empty to
# rely on first-run-only locking alone (setup still self-disables once an admin
# exists). Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_SETUP_SECRET=

# Signed session cookie secret (Phase 3). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public site URL (used for absolute links / WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business WhatsApp number with country code, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ── Contact details (Contact page + footer) ─────────────────────────────
# PLACEHOLDERS — replace with the real business details before launch.
NEXT_PUBLIC_PHONE=+91 00000 00000
NEXT_PUBLIC_ADDRESS=Market Yard, Maharashtra, India
NEXT_PUBLIC_BUSINESS_HOURS=Mon–Sun, 7:00 AM – 8:00 PM
NEXT_PUBLIC_BUSINESS_EMAIL=info@matoshreefruits.com

# Instagram profile — full URL or just @handle. Leave empty to hide the icon.
NEXT_PUBLIC_INSTAGRAM=

# ── Cloudinary (Phase 3 uploads / Phase 4 deletion) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cron (Phase 4) ─────────────────────────────────────────────────────
# Protects /api/cron/expire-posts — Vercel Cron sends this as a Bearer token
CRON_SECRET=
